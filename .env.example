# BhooDrishti-NER Configuration
# Copy this file to .env and fill in values

# Database (SQLite default, set PostgreSQL URL for production)
DATABASE_URL=sqlite:///./bhoodrishti.db
# DATABASE_URL=postgresql://user:password@localhost:5432/bhoodrishti

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application
DEMO_MODE=true
HOST=127.0.0.1
PORT=8000

# Live weather is provided by Open-Meteo (no API key required).
# Configure a sensor-gateway URL before enabling real IoT telemetry.
# SENSOR_GATEWAY_URL=
